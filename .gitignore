# Environment
.env
.env.local

# Database (db.ts resolve relatif ke folder backend/, aman dari cwd apa pun)
backend/db/*.sqlite
backend/db/*.sqlite-shm
backend/db/*.sqlite-wal
# Jaring pengaman kalau ada yang bikin DB nested (pernah kejadian: backend/backend/db/)
**/db/*.sqlite
**/db/*.sqlite-shm
**/db/*.sqlite-wal

# Backups
backups/

