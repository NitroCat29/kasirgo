{
	"name": "electrobun-solid",
	"version": "1.0.0",
	"type": "module",
	"description": "Electrobun app with SolidJS and Vite HMR",
	"scripts": {
		"dev": "electrobun dev --watch",
		"dev:hmr": "electrobun dev --watch",
		"build:web": "vite build",
		"build:canary": "vite build && electrobun build --env=canary",
		"build": "vite build && electrobun build"
	},
	"dependencies": {
		"electrobun": "1.18.1"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"solid-js": "^1.9.3",
		"typescript": "^5.7.2",
		"vite": "^6.0.3",
		"vite-plugin-solid": "^2.11.0"
	}
}
